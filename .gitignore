# Unity generated / managed folders
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Visual Studio / Rider / VS Code generated
.vs/
.vsconfig
.idea/
*.csproj
*.sln
*.suo
*.user
*.userprefs
*.unityproj
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds — keep the playable build, but exclude Unity's debug-symbol backup
# folder (it is not meant to ship and contains files over GitHub's 100MB limit).
**/*_BackUpThisFolder_ButDontShipItWithYourGame/
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics
crashlytics-build.properties

# Plastic SCM
.plastic/
plastic.workspace
